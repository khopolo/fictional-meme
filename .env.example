# Load with: node --env-file=.env server/index.js
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for backend mutations only; never send this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only provider credentials. Never use a VITE_ prefix.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# PDF processing bounds; workers process two uploaded files and one OCR task at a time.
MAX_PDF_PAGES=100
MAX_OCR_PAGES=20
# Optional persistent directory for the Tesseract English model cache.
OCR_CACHE_DIR=
