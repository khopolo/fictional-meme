# Load with: node --env-file=.env server/index.js
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for backend mutations only; never send this value to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only provider credentials. Never use a VITE_ prefix.
# For this app, use an OpenAI-compatible API key from OpenAI, Azure OpenAI, or a compatible provider.
# GitHub Copilot is not a direct backend API for this app.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# PayFast subscription configuration. Get sandbox/live values from the matching
# PayFast merchant account; never mix credentials between modes or commit .env.
# Production return/cancel/notify URLs must be public HTTPS endpoints.
PAYFAST_MERCHANT_ID=11439617
PAYFAST_MERCHANT_KEY=smbpyukosdzik
PAYFAST_PASSPHRASE=Sanelem5435.
PAYFAST_MODE=sandbox
PAYFAST_RETURN_URL=https://your-domain.example/checkout/success
PAYFAST_CANCEL_URL=https://your-domain.example/checkout/cancel
PAYFAST_NOTIFY_URL=https://your-domain.example/api/payfast/notify

# PDF processing bounds; workers process two uploaded files and one OCR task at a time.
MAX_PDF_PAGES=100
MAX_OCR_PAGES=20
# Optional persistent directory for the Tesseract English model cache.
OCR_CACHE_DIR=
